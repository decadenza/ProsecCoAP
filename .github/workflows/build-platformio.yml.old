name: build-platformio
on: [push, pull_request, workflow_dispatch]

jobs:
  build:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        # We group boards by their architecture to handle dependencies
        include:
          - board: uno
            platform: atmelavr
          - board: esp32thing
            platform: espressif32
          - board: nodemcuv2
            platform: espressif8266

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Cache pip
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-${{ hashFiles('**/requirements.txt') }}

      - name: Cache PlatformIO
        uses: actions/cache@v4
        with:
          path: ~/.platformio
          key: ${{ runner.os }}-pio-${{ matrix.board }}

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: "3.x"

      - name: Install PlatformIO
        run: |
          python -m pip install --upgrade pip
          pip install --upgrade platformio

      - name: Build Examples
        run: |
          # 1. Install specific requirements based on the board
          if [ "${{ matrix.board }}" == "uno" ]; then
            pio lib install "Ethernet"
          fi

          # 2. Loop through every .ino file
          for example in examples/*/*.ino; do
            echo "-------------------------------------------------------"
            echo "BUILDING: $example for ${{ matrix.board }}"
            echo "-------------------------------------------------------"
            
            # Using --project-conf or -O to ensure WiFi is available for ESP boards
            # we use -O to inject "lib_deps" dynamically
            pio ci "$example" \
              --board=${{ matrix.board }} \
              --lib="." \
              -O "lib_deps=Ethernet" \
              -O "build_flags=-D PLATFORMIO_CI"
          done
